#!/bin/sh
set -eu

APP_ROOT="${ASA_INDUSTRY_NEWS_ROOT:-$HOME/.local/share/asa-industry-news}"
REPO="$APP_ROOT/repo"
BRIDGE_REF="${ASA_INDUSTRY_NEWS_REF:-feat/asa-intelligence-routing}"
VAULT_ROOT="${ASA_VAULT_ROOT:-$HOME/Documents/Documents - Troy’s MacBook Air/Main local Vault}"

if [ ! -d "$REPO/.git" ]; then
  echo "managed Industry News repository is missing: $REPO" >&2
  exit 1
fi

git -C "$REPO" pull --ff-only origin "$BRIDGE_REF"
export MIOS_VAULT_RECEIPT_KEY="$(security find-generic-password -w -s ai.hermes.asa-industry-news.vault-receipt)"
export ACTION_OS_INDUSTRY_NEWS_CAPABILITY="$(security find-generic-password -w -s ai.hermes.asa-industry-news.action-os)"
export ACTION_OS_URL="${ACTION_OS_URL:-http://127.0.0.1:8890}"

cd "$REPO"
exec "$HOME/.local/bin/uv" run --with-requirements "$REPO/requirements.txt" \
  python -m intel.vault_bridge \
  --package-root "$REPO/intel" \
  --vault-root "$VAULT_ROOT"
